# Environment Configuration Example
# Copy this file to .env in backend/ for local development:
# cp .env.example .env

# Database Configuration
DATABASE_URL=postgresql+psycopg://academic_coach:academic_coach_dev_pass@localhost:5432/ai_academic_coach

# Security Configuration (Placeholders - DO NOT use real production secrets here)
SECRET_KEY=change_this_to_a_secure_random_key_in_production_environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://localhost
